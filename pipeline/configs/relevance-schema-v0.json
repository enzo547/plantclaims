{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlantClaims relevance record v0.1",
  "description": "Record structure. The versioned reason/action registry, source identity, exact evidence, and label-dependent requirements are enforced by the Python validator. Human review records add supersedes before this validation.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "buckets",
        "evidence",
        "label",
        "missing_reason",
        "next_action",
        "paper_id",
        "plant_subject",
        "rationale",
        "reason_code",
        "research_question",
        "status",
        "text_sha256"
      ],
      "properties": {
        "paper_id": {
          "type": "string",
          "minLength": 1
        },
        "text_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "status": {
          "const": "assessed"
        },
        "label": {
          "enum": [
            "core",
            "adjacent",
            "off_topic",
            "insufficient_evidence"
          ]
        },
        "reason_code": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "plant_subject": {
          "type": [
            "string",
            "null"
          ]
        },
        "research_question": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "block_id",
              "quote"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "block_id": {
                "type": "string",
                "minLength": 1
              },
              "quote": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "buckets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "bucket_id",
              "evidence_ids"
            ],
            "properties": {
              "bucket_id": {
                "enum": [
                  "B1",
                  "B2",
                  "B3",
                  "B4",
                  "B5",
                  "B6",
                  "B7",
                  "B8"
                ]
              },
              "evidence_ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "missing_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "next_action": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paper_id",
        "text_sha256",
        "status",
        "error"
      ],
      "properties": {
        "paper_id": {
          "type": "string",
          "minLength": 1
        },
        "text_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "status": {
          "const": "execution_failed"
        },
        "error": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  ]
}
